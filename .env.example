# =========================================================
#  프론트엔드 (빌드 시점에 박힌다 — 바꾸면 다시 빌드해야 한다)
# =========================================================

# 데이터 소스 선택
#   local = 브라우저 localStorage (DB 없이 동작 · 초안 단계)
#   rest  = server/index.js 의 /api 사용 (Azure SQL 연동)
VITE_DATA_SOURCE=rest

# rest 를 쓸 때 API 기본 경로. 같은 서버에서 서빙하면 그대로 두면 된다.
# VITE_API_BASE=/api


# =========================================================
#  서버 (런타임에 읽는다 — App Service 앱 설정에 넣는다)
# =========================================================

SQL_SERVER=mcb-hr-management.database.windows.net
SQL_DATABASE=MCB-HR-Management-DB

# 인증 방식
#   msi = 관리 ID (App Service 기본값 · 비밀번호 없음)
#   sql = SQL 인증 (로컬 개발용)
SQL_AUTH=msi

# SQL_AUTH=sql 일 때만 필요. 절대 커밋하지 말 것.
# SQL_USER=mcbsqladmin
# SQL_PASSWORD=

# 서버리스 자동 일시중지(60분) 대비 재시도. 기본값으로 충분하다.
# SQL_MAX_ATTEMPTS=5
# SQL_RETRY_BASE_MS=1500
# SQL_POOL_MAX=10
