<?xml version="1.0" encoding="utf-8"?>
<!--
  Windows 기반 Azure App Service(iisnode)용 설정.
  Linux App Service 에 배포한다면 이 파일은 사용되지 않으며,
  시작 명령(Startup Command)에 `node server/index.js` 만 넣으면 된다.
-->
<configuration>
  <system.webServer>
    <webSocket enabled="false" />

    <handlers>
      <add name="iisnode" path="server/index.js" verb="*" modules="iisnode" />
    </handlers>

    <rewrite>
      <rules>
        <!-- iisnode 디버깅 엔드포인트는 그대로 통과 -->
        <rule name="NodeInspector" patternSyntax="ECMAScript" stopProcessing="true">
          <match url="^server/index.js\/debug[\/]?" />
        </rule>

        <!-- 그 외 모든 요청은 Node 앱으로 -->
        <rule name="DynamicContent">
          <match url="/*" />
          <action type="Rewrite" url="server/index.js" />
        </rule>
      </rules>
    </rewrite>

    <!-- 소스 디렉터리 노출 차단 -->
    <security>
      <requestFiltering>
        <hiddenSegments>
          <add segment="node_modules" />
          <add segment="src" />
          <add segment="scripts" />
        </hiddenSegments>
      </requestFiltering>
    </security>

    <httpErrors existingResponse="PassThrough" />

    <iisnode
      nodeProcessCommandLine="node"
      loggingEnabled="true"
      logDirectory="..\..\LogFiles\nodejs" />
  </system.webServer>
</configuration>
